# Copy this file to .env and fill in your own key. Never commit the real .env file.

# Required: get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown below are used if you omit these)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=64
TOP_K=4
TEMPERATURE=0.2
